--[[
	Actualiza los stats de la base periÃÂ³dicamente.
]]
local function startStatsUpdateLoop()
	task.spawn(function()
		while true do
			task.wait(1) -- Update cada segundo

			-- Obtener objetos de la base
			local objects = BaseOwnershipService:GetMyObjects()

			-- Actualizar label
			if baseStatsFrame then
				local objectsLabel = baseStatsFrame:FindFirstChild("ObjectsLabel") :: TextLabel?
				if objectsLabel then
					objectsLabel.Text = string.format("Objects: %d", objects and #objects or 0)
				end
			end
		end
	end)
end

